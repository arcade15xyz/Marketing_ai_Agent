# Phase 2 does not publish or call platform APIs.
# Keep all future secrets in environment variables only.

TIMEZONE=Asia/Calcutta
DAILY_POST_TIME=09:30
COMPANY_NAME="Ftechiz Pvt. Ltd."

# Set to database only after migrations and the JSON import succeed.
STORAGE_BACKEND=json
DATABASE_URL=postgresql+psycopg://marketing:change-me@localhost:5432/marketing_ai
DATABASE_ECHO=false
# Content creation is independent of STORAGE_BACKEND.
CONTENT_SOURCE_MODE=json
WEEKLY_POST_COUNT=7



# External integrations
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_PERSON_ID

# Keep true until you intentionally enable publishing.
PUBLISHING_KILL_SWITCH=true

